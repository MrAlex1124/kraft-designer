{
  "id": "/",
  "name": "Kraft Designer – böngészős 3D CAD",
  "short_name": "Kraft Designer",
  "description": "Önálló 3D CAD tervező és modellező a böngésződben.",
  "lang": "hu",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/vnd.layerling.project+zip": [
          ".lyl"
        ]
      }
    }
  ],
  "orientation": "any",
  "background_color": "#f5f9ff",
  "theme_color": "#007bff",
  "categories": [
    "graphics",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "assets/layerling/layerling-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/layerling/layerling-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/layerling/layerling-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/layerling/layerling-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
